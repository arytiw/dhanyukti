# Copy to .env and fill in real values.
# This file is safe to commit; .env is NOT.

# ---------- Database ----------
MYSQL_ROOT_PASSWORD=change_me

# ---------- Auth / JWT ----------
# MUST be identical for User, Stonks, Expenses, Investment, Tax (all validate the same JWT).
# Use the same base64 secret everywhere. Example below matches codebase defaults (dev only).
JWT_SECRET=KGJkNjRmNzA1ZjUyYjI5Mjc4ZjM4ZjllMjc0MjM1Mzg4ODBmMWY2NGU2NDBlNjBmZGE2MTM1Yjg5MTQzYzA1Nyk=

# ---------- Email (User service) ----------
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# ---------- Razorpay (backend service) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---------- Razorpay (frontend checkout.js) ----------
# NOTE: Vite reads this at BUILD time (docker build), not at runtime.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ---------- Support / Gemini ----------
GEMINI_API_KEY=your_gemini_key
SUPPORT_CORS_ALLOWED_ORIGINS=http://localhost

# ---------- Market data (Stonks) ----------
ALPHAVANTAGE_API_KEY=your_alphavantage_key
GOLDAPI_API_KEY=your_goldapi_key
