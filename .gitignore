# ==========================================
# Dhanyukti - Root .gitignore
# ==========================================

# ---------- Secrets & Environment ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Java / Maven ----------
target/
*.jar
*.war
*.ear
*.class
*.log
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---------- Node / Frontend ----------
node_modules/
dist/
dist-ssr/
*.local
.npm
.yarn/
.pnp.*
bun.lockb

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- IDE & Editors ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Eclipse
.metadata/
.recommenders/
*.launch
*.pydevproject
.cproject

# ---------- OS & Misc ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.bak

# ---------- Build & Cache ----------
*.tmp
*.temp
.cache/
build/
out/

# ---------- Docker (local overrides) ----------
docker-compose.override.yml
.docker/

# ---------- Test & Coverage ----------
coverage/
*.lcov
.nyc_output/
*.test.js.snap

# ---------- Misc ----------
*.pid
*.seed
*.pid.lock
.npmrc
.yarnrc
.pnp.cjs
